[Desktop Entry]
Type=Application
Version=1.0
Name=Prepare for shipping to end user
Name[en_US]=Prepare for shipping to end user
Comment=Ubuntu OEM handover (oem-config-prepare). Requires oem-prepare-shipping.sh installed at Exec path (not deployed by linux-oem-setup-utils pipeline). Run once, then shut down when prompted.
Exec=pkexec /usr/local/bin/oem-prepare-shipping
Icon=system-shutdown
Terminal=false
Categories=Settings;System;
StartupNotify=true
